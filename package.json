{
  "name": "jp-qualification-media",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests --pool=threads --poolOptions.threads.singleThread",
    "lint": "eslint .",
    "format:check": "prettier --check \"*.{json,md,mjs,yml,yaml}\" \".github/**/*.{yml,yaml}\" \"apps/**/*.ts\" \"config/**/*.json\" \"docs/**/*.md\" \"packages/**/*.ts\" \"scripts/**/*.mjs\" \"services/*/src/**/*.{ts,mjs}\" \"tests/**/*.ts\"",
    "dev:api": "tsx services/api/src/server.ts",
    "dev:web": "tsx apps/web/src/server.ts",
    "dev:admin": "tsx apps/admin/src/server.ts",
    "test:python": "python -m pytest -p no:cacheprovider --basetemp=.pytest-basetemp services/collector/tests services/parser/tests",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "test:verify-gate": "node --test scripts/verify-lib.test.mjs",
    "baseline:update": "node scripts/update-release-baseline.mjs",
    "release:check": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm test:python && pnpm run build && pnpm test:verify-gate && pnpm verify:all",
    "ci:fixture:export": "node scripts/export-ci-db-fixture.mjs",
    "ci:fixture:restore": "node scripts/restore-ci-db-fixture.mjs",
    "ci:fixture:verify": "node scripts/verify-ci-fixture.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.4.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
