# 生产环境变量模板：复制为 deploy/.env 并填真实值，不要提交 .env
# docker compose 会自动读取 compose 文件同目录的 .env 做 ${} 插值

# 数据库密码：用 `openssl rand -hex 24` 生成，只存 deploy/.env
DB_PASSWORD=change-me

# 公开 API 的只读账号口令：同样用 `openssl rand -hex 24` 生成，只存 deploy/.env
# 首次部署/迁移后需运行 db:provision-api-role 开通，见 docs/runbook.md
API_DB_PASSWORD=change-me

# 可选：Google Search Console 的 HTML 标签验证 token。
# 留空则不在页面输出该 meta 标签。
GOOGLE_SITE_VERIFICATION=

# 可选：GA4 衡量 ID（形如 G-XXXXXXXXXX）。留空则不加载任何统计脚本；
# 填值后也只在访客通过 Cookie 同意横幅同意后加载（M2 合规门控），启用步骤见 docs/runbook.md「GA4 启用」节。
GA_MEASUREMENT_ID=

# 可选：飞书群自定义机器人的 webhook 地址（形如
# https://open.feishu.cn/open-apis/bot/v2/hook/<token>）。
# 留空则不发送飞书通知，定时探针只写 syslog。填好后用
# `sh scripts/notify-feishu.sh --test` 自检，见 docs/runbook.md「飞书通知」节。
FEISHU_WEBHOOK=

# 可选：飞书机器人开启「签名校验」时填这里的密钥；留空表示机器人未启用签名校验。
# 注意脚本按 grep + cut 读取，值里的 `=` 会被完整保留。
FEISHU_SIGN_SECRET=

# admin 后台（/admin/）的 HTTP Basic 账号。格式：
#   name:scrypt:<saltHex>:<hashHex>
# 用 `node scripts/admin-hash-password.mjs <name>` 生成（口令从 ADMIN_PASSWORD 读，
# 或交互输入）。多个账号用英文逗号分隔。生产环境必须填：
# 未设置时 admin 容器会拒绝启动（fail closed）。
ADMIN_AUTH_USERS=
