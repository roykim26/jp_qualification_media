# 生产环境变量模板：复制为 deploy/.env 并填真实值，不要提交 .env
# docker compose 会自动读取 compose 文件同目录的 .env 做 ${} 插值

# 数据库密码：用 `openssl rand -hex 24` 生成，只存 deploy/.env
DB_PASSWORD=change-me

# 公开 API 的只读账号口令：同样用 `openssl rand -hex 24` 生成，只存 deploy/.env
# 首次部署/迁移后需运行 db:provision-api-role 开通，见 docs/runbook.md
API_DB_PASSWORD=change-me

# 可选：Google Search Console 的 HTML 标签验证 token。
# 留空则不在页面输出该 meta 标签。
GOOGLE_SITE_VERIFICATION=

# 可选：GA4 衡量 ID（形如 G-XXXXXXXXXX）。留空则不加载任何统计脚本。
GA_MEASUREMENT_ID=
